# Copy to .env (repo root for docker compose, or backend/.env when running the API on the host).
# Values below are the defaults for running the backend on the host against `docker compose up`.

# --- Datastores (host ports from docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://courseai:courseai@localhost:5433/courseai
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6380/0

# --- Embeddings: BGE-m3 via the embedder service ---
# EMBEDDER_BACKEND=hash skips the model entirely (fast, low quality; tests/CI)
EMBEDDER_BACKEND=http
EMBEDDER_URL=http://localhost:8001
EMBEDDING_DIM=1024

# --- LLM: default OpenAI gpt-4o-mini ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Local alternative (Ollama + Qwen; `docker compose --profile local-llm up` or a host install):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
COOKIE_SECURE=false

# --- RAG tuning ---
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
CHUNK_TOKENIZER=BAAI/bge-m3
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
HYBRID_SEARCH=true
RERANK_ENABLED=true
MAX_UPLOAD_MB=50
INGEST_MODE=queue
